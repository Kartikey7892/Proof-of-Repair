# Copy to .env (read by the Node server at startup). Everything is optional.

# --- PostgreSQL -------------------------------------------------------------
# Real PostgreSQL (recommended). `docker compose up -d` starts one matching this URL,
# or point it at a native install / managed instance (Neon, RDS, Supabase…).
# DATABASE_URL=postgres://por:por@127.0.0.1:5432/por
# PG_POOL_MAX=10
#
# When DATABASE_URL is unset the server runs an embedded PostgreSQL (PGlite)
# stored under artifacts/pglite — same SQL, zero setup, single process.
# PGLITE_DIR=artifacts/pglite

# --- HTTP -------------------------------------------------------------------
# PORT=8000
# HOST=127.0.0.1

# --- Diagnosis engines ------------------------------------------------------
# Python sidecar for the fine-tuned LoRA engines (python ml/inference_server.py).
# The built-in knowledge-base engine needs nothing.
# INFERENCE_URL=http://127.0.0.1:8001

# --- Blockchain anchoring ---------------------------------------------------
# Local Hardhat defaults are written to artifacts/chain_config.json by
# scripts/start_live_chain.sh. Without it, a file-persisted simulator is used.
# CHAIN_CONFIG=artifacts/chain_config.json
#
# Optional Sepolia (public testnet) credentials for scripts/deploy_sepolia.sh.
# Get a free RPC from Alchemy/Infura and Sepolia ETH from a faucet.
# SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
# DEPLOYER_PRIVATE_KEY=0xYOUR_FUNDED_SEPOLIA_PRIVATE_KEY

# --- OpenTimestamps ---------------------------------------------------------
# auto (default: public calendars, simulator if unreachable) | live | sim
# OTS_MODE=auto
# OTS_CALENDARS=https://alice.btc.calendar.opentimestamps.org,https://bob.btc.calendar.opentimestamps.org

# --- Runtime state ----------------------------------------------------------
# Evidence blobs, OTS receipts, simulator ledger, embedded DB.
# ARTIFACTS_DIR=artifacts
